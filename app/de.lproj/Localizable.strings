/* German translation of the app. The English text is the key, so SwiftUI literals and the
   strings that the code passes to localized() both find their translation here. */

/* Buttons and switches */
"Start Logic Pro" = "Logic Pro starten";
"Check for Updates" = "Nach Updates suchen";
"Start Logic Pro automatically" = "Logic Pro automatisch starten";
"Cancel" = "Abbrechen";
"Get %@" = "%@ herunterladen";

/* Labels */
