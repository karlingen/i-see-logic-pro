"Text contrast" = "Textkontrast";
"Middle grays" = "Mittlere Grautöne";
"Dark" = "Dunkel";
"Light" = "Hell";
"Soft" = "Weich";
"Crisp" = "Kräftig";
"Starting Logic Pro in" = "Logic Pro startet in";

/* Help text of the auto start switch */
"Each time that this app opens, it counts down %ld seconds and starts Logic Pro. Click Cancel to change the settings first." = "Bei jedem Öffnen dieser App werden %ld Sekunden heruntergezählt, dann startet Logic Pro. Mit „Abbrechen“ ändern Sie vorher die Einstellungen.";

